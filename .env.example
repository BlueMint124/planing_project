# Demo mode returns the fixed 제주 itinerary without calling external APIs.
DEMO_MODE=true

# Server-only API keys. Never expose these with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GOOGLE_MAPS_API_KEY=
SUPABASE_SECRET_KEY=
LIVE_GENERATION_TIMEOUT_MS=30000

# Browser-safe public configuration.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
